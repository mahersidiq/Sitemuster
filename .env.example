# SiteMuster environment variable NAMES only. Never put real values in this file or in Git.
# Where each value lives is documented in docs/setup/HUMAN_CHECKLIST.md.

# Build-time app environment: development | staging | production (default: development).
APP_ENV=development

# Public (non-secret) values compiled into the mobile bundle. Safe ONLY with correct RLS.
# Set per EAS environment; production builds refuse to configure without them.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_SENTRY_DSN=

# Non-secret Expo/EAS identifiers.
EAS_PROJECT_ID=
EXPO_OWNER=

# Sentry source-map upload (build machine/EAS secret only; never EXPO_PUBLIC_).
SENTRY_ORG=
SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN lives only in EAS/GitHub protected secrets.

# Server-only secrets (Supabase Edge Function secrets) are NOT listed with values here and must
# never be prefixed EXPO_PUBLIC_: SUPABASE_SERVICE_ROLE_KEY, DEVICE_CREDENTIAL_PEPPER,
# BADGE_SECRET_ENCRYPTION_KEY, GOOGLE_PLACES_SERVER_KEY, GOOGLE_GEOCODING_SERVER_KEY,
# TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, TWILIO_MESSAGING_SERVICE_SID.
