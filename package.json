{
  "name": "sitemuster",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings=0 && npm run lint:shell",
    "lint:shell": "shellcheck scripts/*.sh tools/ui-preview/*.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run --project unit && jest --selectProjects mobile-unit",
    "test:integration": "vitest run --project integration && jest --selectProjects mobile-integration",
    "test:security": "vitest run --project security",
    "test:i18n": "vitest run --project i18n",
    "test:location-replay": "vitest run --project replay",
    "test": "npm run test:unit && npm run test:integration && npm run test:security && npm run test:i18n && npm run test:location-replay",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "dependencies": {
    "@expo/metro-runtime": "58.0.17",
    "@hookform/resolvers": "7.0.2",
    "@noble/ciphers": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@sentry/react-native": "8.28.0",
    "@sitemuster/shared": "0.1.0",
    "@supabase/supabase-js": "2.118.0",
    "@tanstack/react-query": "5.105.3",
    "expo": "58.0.23",
    "expo-camera": "58.0.14",
    "expo-constants": "58.0.15",
    "expo-crypto": "58.0.7",
    "expo-dev-client": "58.0.18",
    "expo-linking": "58.0.16",
    "expo-localization": "58.0.5",
    "expo-notifications": "58.1.8",
    "expo-router": "58.0.30",
    "expo-secure-store": "58.0.2",
    "expo-sharing": "58.0.22",
    "expo-sqlite": "58.0.15",
    "expo-status-bar": "58.0.4",
    "expo-system-ui": "58.0.7",
    "i18next": "26.7.1",
    "react": "19.3.0",
    "react-hook-form": "7.91.0",
    "react-i18next": "17.1.12",
    "react-native": "0.88.1",
    "react-native-background-geolocation": "5.8.2",
    "react-native-maps": "1.29.11",
    "react-native-qrcode-svg": "6.3.52",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "4.30.1",
    "react-native-svg": "15.16.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.88.1",
    "@testing-library/react-native": "14.1.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "babel-preset-expo": "58.0.24",
    "eslint": "9.39.5",
    "eslint-config-expo": "58.0.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-i18next": "6.1.5",
    "jest": "30.5.2",
    "jest-expo": "58.0.14",
    "prettier": "3.9.10",
    "test-renderer": "1.3.0",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  },
  "overrides": {
    "react-dom": "19.3.0"
  }
}
